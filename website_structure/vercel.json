{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/subscribe.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/newsletter",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/newsletter/:slug",
      "destination": "/insights/:slug",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/old-home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/coaching/1-1-transformation",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/coaching/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/5-mental-fitness-techniques",
      "destination": "/insights",
      "permanent": true
    }
  ]
}
