{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/subscribe.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/readiness.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/contact.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/newsletter",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/newsletter/:slug",
      "destination": "/insights/:slug",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/old-home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/about-me",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/consulting-excellence",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/executive-coaching-mid-senior-leaders",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/high-performance-team-coaching",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/leadership-accelerator",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/cookie-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/coaching/1-1-transformation",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/coaching/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/5-mental-fitness-techniques",
      "destination": "/insights",
      "permanent": true
    }
  ]
}
