{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/subscribe.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/newsletter",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/newsletter/:slug",
      "destination": "/insights/:slug",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
